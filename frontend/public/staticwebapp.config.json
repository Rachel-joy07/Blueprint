{
  "routes": [
    {
      "route": "/api/scans",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/scans/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "/*.{css,js,svg,png,ico,map}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
